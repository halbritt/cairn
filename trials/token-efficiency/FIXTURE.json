    {
      "id": "single_notice",
      "actor_task": "Process the single routine build notice for Cairn and record its exact disposition.",
      "setup": {
        "sources": [],
        "events": [
          {
            "id": "notice_a",
            "kind": "notice",
            "recipient": "worker",
