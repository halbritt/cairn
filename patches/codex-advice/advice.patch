new file mode 100644
index 0000000..30b2310
--- /dev/null
+++ b/codex-rs/cli/src/advice.rs
@@ -0,0 +1,591 @@
+//! One bounded subscription request. This deliberately does not start an agent session.
+use clap::Parser;
+use codex_api::{
+    ApiError, Provider, ResponseEvent, ResponsesApiRequest, ResponsesClient, ResponsesOptions,
+    SharedAuthProvider,
+};
+use codex_app_server::in_process::EmbeddedNetworkPolicy;
+use codex_cloud_config::managed_config_bundle_loader_for_storage;
+use codex_config::config_toml::ConfigToml;
+use codex_config::{CloudConfigBundleLoader, ConfigLoadOptions, LoaderOverrides};
+use codex_core::config::{
+    ConfigBuilder, ConfigOverrides, bootstrap_auth_config, find_codex_home,
+    load_config_toml_with_layer_stack,
+};
+use codex_http_client::{
+    ClientRouteClass, HttpTransport, Request, ReqwestTransport, Response, StreamResponse,
+    TransportError,
+};
+use codex_login::default_client::set_default_client_residency_requirement;
+use codex_login::{AuthConfig, AuthManager, CodexAuth};
+use codex_model_provider::{
+    WorkspaceRoutingContext, auth_provider_from_auth, create_model_provider, resolve_api_provider,
+};
+use codex_model_provider_info::ModelProviderInfo;
+use codex_protocol::models::{ContentItem, ResponseItem};
+use futures::StreamExt;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicU8, Ordering};
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tracing::instrument::WithSubscriber;
+use uuid::Uuid;
+
+const REQUEST_SCHEMA: &str = "cairn.codex-advice-request/1";
+const RESULT_SCHEMA: &str = "cairn.codex-advice-result/1";
+const INPUT_LIMIT: usize = 262_144;
+const STREAM_LIMIT: usize = 2_097_152;
+const TOKEN_ENDPOINT: &str = "https://auth.openai.com/oauth/token";
+
+#[derive(Debug, Parser)]
+pub struct Cli {
+    /// Print the nonsecret contract without reading input, configuration or credentials.
+    #[arg(long)]
+    pub capabilities: bool,
+    #[arg(long, required_unless_present = "capabilities")]
+    pub model: Option<String>,
+    #[arg(long, default_value_t = 90_000, value_parser = clap::value_parser!(u64).range(10_000..=180_000))]
+    pub timeout_ms: u64,
+    #[arg(long, default_value_t = 65_536, value_parser = clap::value_parser!(u64).range(1_024..=262_144))]
+    pub max_output_bytes: u64,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input {
+    schema: String,
+    request_id: String,
+    prompt: String,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Failure {
+    InvalidRequest,
+    AuthUnavailable,
+    AuthUnsupported,
+    PolicyRefused,
+    QuotaExhausted,
+    ProviderError,
+    Timeout,
+    OutputLimit,
+    Cancelled,
+}
+impl Failure {
+    fn code(self) -> &'static str {
+        match self {
+            Self::InvalidRequest => "INVALID_REQUEST",
+            Self::AuthUnavailable => "AUTH_UNAVAILABLE",
+            Self::AuthUnsupported => "AUTH_UNSUPPORTED",
+            Self::PolicyRefused => "POLICY_REFUSED",
+            Self::QuotaExhausted => "QUOTA_EXHAUSTED",
+            Self::ProviderError => "PROVIDER_ERROR",
+            Self::Timeout => "TIMEOUT",
+            Self::OutputLimit => "OUTPUT_LIMIT",
+            Self::Cancelled => "CANCELLED",
+        }
+    }
+    fn message(self) -> &'static str {
+        match self {
+            Self::InvalidRequest => "The advice request is invalid.",
+            Self::AuthUnavailable => "The selected subscription authentication is unavailable.",
+            Self::AuthUnsupported => "The selected authentication is not supported for advice.",
+            Self::PolicyRefused => "The selected policy or route does not permit advice.",
+            Self::QuotaExhausted => "The subscription quota or rate limit prevents advice.",
+            Self::ProviderError => "The provider did not return a complete advice result.",
+            Self::Timeout => "The advice deadline expired.",
+            Self::OutputLimit => "The advice output exceeded its bound.",
+            Self::Cancelled => "The advice operation was cancelled.",
+        }
+    }
+}
+
+fn failure_value(id: Option<&str>, failure: Failure) -> Value {
+    json!({"schema":RESULT_SCHEMA,"request_id":id,"ok":false,"error":{"code":failure.code(),"message":failure.message()}})
+}
+fn success_value(id: &str, model: &str, result: &str) -> Value {
+    json!({"schema":RESULT_SCHEMA,"request_id":id,"ok":true,"model":model,"provider":"openai","auth_method":"chatgpt_subscription","result":result})
+}
+fn parse_input(bytes: &[u8]) -> Result<Input, Failure> {
+    if bytes.len() > INPUT_LIMIT {
+        return Err(Failure::InvalidRequest);
+    }
+    let input: Input = serde_json::from_slice(bytes).map_err(|_| Failure::InvalidRequest)?;
+    let id = Uuid::parse_str(&input.request_id).map_err(|_| Failure::InvalidRequest)?;
+    if input.schema != REQUEST_SCHEMA
+        || id.is_nil()
+        || id.to_string() != input.request_id
+        || input.prompt.trim().is_empty()
+    {
+        return Err(Failure::InvalidRequest);
+    }
+    Ok(input)
+}
+
+/// The caller owns process-group termination; SIGINT/SIGTERM also close our request promptly.
+pub async fn run(cli: Cli) -> i32 {
+    if cli.capabilities {
+        println!(
+            "{}",
+            json!({"schema":"cairn.codex-advice-capabilities/1","request_schema":REQUEST_SCHEMA,"result_schema":RESULT_SCHEMA,"provider":"openai","auth_method":"chatgpt_subscription","one_request":true,"tools":false,"retries":false,"upstream_commit":"6ff1e1ca3b30fc8b914720681fcf5fe62e95f856","patch_sha256":option_env!("CAIRN_ADVICE_PATCH_SHA256").unwrap_or("unverified")})
+        );
+        return 0;
+    }
+    let mut id = None;
+    let operation = async {
+        let model = cli.model.as_deref().ok_or(Failure::InvalidRequest)?;
+        if model.is_empty()
+            || model.len() > 128
+            || !model
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || b"-_.".contains(&c))
+        {
+            return Err(Failure::InvalidRequest);
+        }
+        let mut bytes = Vec::new();
+        tokio::io::stdin()
+            .take((INPUT_LIMIT + 1) as u64)
+            .read_to_end(&mut bytes)
+            .await
+            .map_err(|_| Failure::InvalidRequest)?;
+        let input = parse_input(&bytes)?;
+        id = Some(input.request_id.clone());
+        let result = generate(
+            &input,
+            model,
+            cli.max_output_bytes as usize,
+            Duration::from_millis(cli.timeout_ms),
+        )
+        .await?;
+        Ok(success_value(&input.request_id, model, &result))
+    };
+    let result = tokio::select! {
+        result = tokio::time::timeout(Duration::from_millis(cli.timeout_ms), operation.with_subscriber(tracing::subscriber::NoSubscriber::default())) => result.unwrap_or(Err(Failure::Timeout)),
+        _ = cancelled() => Err(Failure::Cancelled),
+    };
+    let mut value = match result {
+        Ok(value) => value,
+        Err(error) => failure_value(id.as_deref(), error),
+    };
+    let mut bytes = serde_json::to_vec(&value).expect("advice envelope is serializable");
+    if bytes.len() + 1 > cli.max_output_bytes as usize {
+        value = failure_value(id.as_deref(), Failure::OutputLimit);
+        bytes = serde_json::to_vec(&value).expect("advice error is serializable");
+    }
+    bytes.push(b'\n');
+    let ok = value["ok"] == true;
+    let mut stdout = tokio::io::stdout();
+    if stdout.write_all(&bytes).await.is_err() || stdout.flush().await.is_err() {
+        return 1;
+    }
+    if ok { 0 } else { 1 }
+}
+async fn cancelled() {
+    #[cfg(unix)]
+    {
+        let mut term = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
+            .expect("SIGTERM handler");
+        tokio::select! { _ = term.recv() => {}, _ = tokio::signal::ctrl_c() => {} }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = tokio::signal::ctrl_c().await;
+    }
+}
+
+fn check_environment() -> Result<(), Failure> {
+    const FORBIDDEN: &[&str] = &[
+        "OPENAI_API_KEY",
+        "CODEX_API_KEY",
+        "CODEX_ACCESS_TOKEN",
+        "OPENAI_BASE_URL",
+        "OPENAI_ORGANIZATION",
+        "OPENAI_PROJECT",
+        "CODEX_REFRESH_TOKEN_URL_OVERRIDE",
+        "CODEX_REVOKE_TOKEN_URL_OVERRIDE",
+        "CODEX_APP_SERVER_LOGIN_CLIENT_ID",
+        "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
+        "OPENAI_FEDERATION_RULE_ID",
+        "OPENAI_IDENTITY_TOKEN_FILE",
+        "OPENAI_WORKLOAD_IDENTITY_CONTEXT",
+    ];
+    if FORBIDDEN.iter().any(|key| std::env::var_os(key).is_some())
+        || codex_login::is_workload_identity_selected()
+    {
+        return Err(Failure::PolicyRefused);
+    }
+    Ok(())
+}
+fn check_config(config: &ConfigToml) -> Result<(), Failure> {
+    if config
+        .model_provider
+        .as_deref()
+        .is_some_and(|id| id != "openai")
+        || config.model_providers.contains_key("openai")
+        || config.openai_base_url.is_some()
+        || config
+            .chatgpt_base_url
+            .as_deref()
+            .is_some_and(|url| url.trim_end_matches('/') != "https://chatgpt.com/backend-api")
+    {
+        return Err(Failure::PolicyRefused);
+    }
+    Ok(())
+}
+fn check_auth(auth: &CodexAuth) -> Result<(), Failure> {
+    if !matches!(auth, CodexAuth::Chatgpt(_)) {
+        return Err(Failure::AuthUnsupported);
+    }
+    let tokens = auth
+        .get_token_data()
+        .map_err(|_| Failure::AuthUnavailable)?;
+    if tokens.oauth_provenance.as_ref().is_some_and(|p| {
+        p.issuer.trim_end_matches('/') != "https://auth.openai.com"
+            || p.client_id != codex_login::CLIENT_ID
+    }) {
+        return Err(Failure::PolicyRefused);
+    }
+    if tokens.access_token.is_empty() || auth.get_account_id().is_none() {
+        return Err(Failure::AuthUnavailable);
+    }
+    Ok(())
+}
+fn pin_auth(mut auth: AuthConfig) -> Result<AuthConfig, Failure> {
+    if auth
+        .chatgpt_base_url
+        .as_deref()
+        .is_some_and(|url| url.trim_end_matches('/') != "https://chatgpt.com/backend-api")
+    {
+        return Err(Failure::PolicyRefused);
+    }
+    auth.auth_route_config = auth.auth_route_config.with_authentication_endpoints(
+        [TOKEN_ENDPOINT.parse().expect("fixed OAuth URL")]
+            .into_iter()
+            .collect(),
+    );
+    Ok(auth)
+}
+fn check_destination(destination: &str) -> Result<(), Failure> {
+    let url = url::Url::parse(destination).map_err(|_| Failure::PolicyRefused)?;
+    if url.scheme() != "https"
+        || url.port_or_known_default() != Some(443)
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.query().is_some()
+        || url.fragment().is_some()
+        || url.path().trim_end_matches('/') != "/backend-api/codex"
+        || !url
+            .host_str()
+            .is_some_and(|host| host == "chatgpt.com" || host.ends_with(".chatgpt.com"))
+    {
+        return Err(Failure::PolicyRefused);
+    }
+    Ok(())
+}
+async fn generate(
+    input: &Input,
+    model: &str,
+    max_output: usize,
+    timeout: Duration,
+) -> Result<String, Failure> {
+    check_environment()?;
+    let home = find_codex_home().map_err(|_| Failure::PolicyRefused)?;
+    let overrides = LoaderOverrides {
+        ignore_project_config: true,
+        ignore_user_and_project_exec_policy_rules: true,
+        ..Default::default()
+    };
+    let policy = EmbeddedNetworkPolicy::load(&overrides).await;
+    let bootstrap = load_config_toml_with_layer_stack(
+        home.as_path(),
+        None,
+        vec![],
+        ConfigLoadOptions {
+            loader_overrides: overrides.clone(),
+            strict_config: true,
+            cloud_config_bundle: CloudConfigBundleLoader::default(),
+        },
+    )
+    .await
+    .map_err(|_| Failure::PolicyRefused)?;
+    check_config(&bootstrap.config_toml)?;
+    let bootstrap_auth = pin_auth(policy.bind_bootstrap_auth(
+        bootstrap_auth_config(home.as_path(), &bootstrap).map_err(|_| Failure::PolicyRefused)?,
+    ))?;
+    check_auth(
+        &bootstrap_auth
+            .load_auth(false)
+            .await
+            .map_err(|_| Failure::AuthUnavailable)?
+            .ok_or(Failure::AuthUnavailable)?,
+    )?;
+    let cloud = managed_config_bundle_loader_for_storage(
+        bootstrap_auth,
+        bootstrap.config_layer_stack.requirements_toml(),
+        false,
+    )
+    .await
+    .map_err(|_| Failure::PolicyRefused)?;
+    let mut config = ConfigBuilder::default()
+        .codex_home(home.to_path_buf())
+        .loader_overrides(overrides)
+        .without_project_context()
+        .harness_overrides(ConfigOverrides {
+            model: Some(model.to_owned()),
+            ephemeral: Some(true),
+            ..Default::default()
+        })
+        .strict_config(true)
+        .cloud_config_bundle(cloud)
+        .build_with_validation(|config, _, _| {
+            check_config(config).map_err(|_| std::io::Error::other("advice policy refused"))
+        })
+        .await
+        .map_err(|_| Failure::PolicyRefused)?;
+    config
+        .config_layer_stack
+        .ensure_config_server_applied()
+        .map_err(|_| Failure::PolicyRefused)?;
+    if config.model_provider != ModelProviderInfo::create_openai_provider(None)
+        || config.model_provider_id != "openai"
+        || config.chatgpt_base_url.trim_end_matches('/') != "https://chatgpt.com/backend-api"
+        || config.model.as_deref() != Some(model)
+    {
+        return Err(Failure::PolicyRefused);
+    }
+    policy.activate(&mut config);
+    set_default_client_residency_requirement(config.enforce_residency.value());
+    let auth_config = pin_auth(config.auth_config())?;
+    let manager = AuthManager::shared_from_auth_config(auth_config.clone(), false)
+        .await
+        .map_err(|_| Failure::AuthUnavailable)?;
+    check_auth(&manager.auth_cached().ok_or(Failure::AuthUnavailable)?)?;
+    let (auth, factory) = manager
+        .try_auth_with_http_client_factory()
+        .await
+        .map_err(|_| Failure::AuthUnavailable)?
+        .ok_or(Failure::AuthUnavailable)?;
+    check_auth(&auth)?;
+    if !auth_config.allows_auth(&auth) || manager.refresh_failure_for_auth(&auth).is_some() {
+        return Err(Failure::AuthUnavailable);
+    }
+    let mut info = ModelProviderInfo::create_openai_provider(None);
+    info.env_http_headers = None;
+    info.request_max_retries = Some(0);
+    info.stream_max_retries = Some(0);
+    let provider = resolve_api_provider(&info, Some(&auth)).map_err(|_| Failure::PolicyRefused)?;
+    let owner = create_model_provider(info, Some(manager));
+    let route = owner
+        .route_responses_api_provider(
+            provider,
+            Some(&auth),
+            &WorkspaceRoutingContext::new(config.chatgpt_base_url.clone()),
+        )
+        .await
+        .map_err(|_| Failure::PolicyRefused)?;
+    check_destination(&route.provider.base_url)?;
+    let destination = route.provider.url_for_path("responses");
+    request_once(
+        request_transport(&factory, &destination)?,
+        route.provider,
+        auth_provider_from_auth(&auth),
+        input,
+        model,
+        max_output,
+        timeout,
+    )
+    .await
+}
+
+fn request_transport(
+    factory: &codex_http_client::HttpClientFactory,
+    destination: &str,
+) -> Result<ReqwestTransport, Failure> {
+    let client = codex_http_client::HttpClientBuilder::new()
+        .default_headers(codex_login::default_client::default_headers())
+        .with_chatgpt_cookies(factory)
+        .without_redirects()
+        .without_retries()
+        .without_request_logging()
+        .build_respecting_outbound_proxy_policy(factory, destination, ClientRouteClass::Api)
+        .map_err(|_| Failure::PolicyRefused)?;
+    Ok(ReqwestTransport::from_http_client(client))
+}
+
+struct OnceTransport<T> {
+    inner: T,
+    started: AtomicBool,
+    destination: String,
+    timeout: Duration,
+    stream_failure: Arc<AtomicU8>,
+}
+impl<T: HttpTransport> HttpTransport for OnceTransport<T> {
+    async fn execute(&self, _request: Request) -> Result<Response, TransportError> {
+        Err(TransportError::Build(
+            "advice requires one streaming request".into(),
+        ))
+    }
+    async fn stream(&self, mut request: Request) -> Result<StreamResponse, TransportError> {
+        if request.method != http::Method::POST
+            || request.url != self.destination
+            || self.started.swap(true, Ordering::SeqCst)
+        {
+            return Err(TransportError::Build("advice request refused".into()));
+        }
+        request.response_body_limit_bytes = Some(STREAM_LIMIT);
+        request.timeout = Some(self.timeout);
+        let mut response = self.inner.stream(request).await?;
+        let failure = Arc::clone(&self.stream_failure);
+        response.bytes = Box::pin(response.bytes.map(move |chunk| {
+            if let Err(error) = &chunk {
+                let code = match error {
+                    TransportError::ResponseTooLarge { .. } => 1,
+                    TransportError::Timeout => 2,
+                    TransportError::Policy(_) => 3,
+                    _ => 0,
+                };
+                failure.store(code, Ordering::SeqCst);
+            }
+            chunk
+        }));
+        Ok(response)
+    }
+}
+fn api_failure(error: ApiError) -> Failure {
+    match error {
+        ApiError::Transport(TransportError::ResponseTooLarge { .. }) => Failure::OutputLimit,
+        ApiError::Transport(TransportError::Timeout) => Failure::Timeout,
+        ApiError::Transport(TransportError::Policy(_)) => Failure::PolicyRefused,
+        ApiError::Transport(TransportError::Http { status, .. }) | ApiError::Api { status, .. }
+            if status == http::StatusCode::UNAUTHORIZED
+                || status == http::StatusCode::FORBIDDEN =>
+        {
+            Failure::AuthUnavailable
+        }
+        ApiError::Transport(TransportError::Http { status, .. }) | ApiError::Api { status, .. }
+            if status == http::StatusCode::TOO_MANY_REQUESTS
+                || status == http::StatusCode::PAYMENT_REQUIRED =>
+        {
+            Failure::QuotaExhausted
+        }
+        ApiError::QuotaExceeded
+        | ApiError::UsageNotIncluded
+        | ApiError::RateLimitExceeded { .. }
+        | ApiError::RateLimit(_) => Failure::QuotaExhausted,
+        _ => Failure::ProviderError,
+    }
+}
+async fn request_once<T: HttpTransport>(
+    transport: T,
+    mut provider: Provider,
+    auth: SharedAuthProvider,
+    input: &Input,
+    model: &str,
+    max_output: usize,
+    timeout: Duration,
+) -> Result<String, Failure> {
+    provider.retry.max_attempts = 1;
+    provider.retry.retry_429 = false;
+    provider.retry.retry_5xx = false;
+    provider.retry.retry_transport = false;
+    let stream_failure = Arc::new(AtomicU8::new(0));
+    let transport = OnceTransport {
+        destination: provider.url_for_path("responses"),
+        inner: transport,
+        started: AtomicBool::new(false),
+        timeout,
+        stream_failure: Arc::clone(&stream_failure),
+    };
+    let request = ResponsesApiRequest {
+        model: model.into(),
+        stream: true,
+        service_tier: None,
+        input: vec![ResponseItem::Message {
+            encrypted_content: None,
+            status: None,
+            id: None,
+            role: "user".into(),
+            content: vec![ContentItem::InputText {
+                text: input.prompt.clone(),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }],
+        tools: Some(
+            Arc::<serde_json::value::RawValue>::from(
+                serde_json::value::RawValue::from_string("[]".into()).expect("empty tools JSON"),
+            )
+            .into(),
+        ),
+        tool_choice: "none".into(),
+        parallel_tool_calls: false,
+        reasoning: None,
+        store: false,
+        stream_options: None,
+        include: vec![],
+        prompt_cache_key: None,
+        text: None,
+        client_metadata: None,
+        access_programs: None,
+    };
+    let mut stream = ResponsesClient::new(transport, provider, auth)
+        .stream_request(request, ResponsesOptions::default())
+        .await
+        .map_err(api_failure)?;
+    let mut text = String::new();
+    while let Some(event) = stream.next().await {
+        let event = event.map_err(|error| match stream_failure.load(Ordering::SeqCst) {
+            1 => Failure::OutputLimit,
+            2 => Failure::Timeout,
+            3 => Failure::PolicyRefused,
+            _ => api_failure(error),
+        })?;
+        match event {
+            ResponseEvent::ServerModel(actual) if actual != model => {
+                return Err(Failure::PolicyRefused);
+            }
+            ResponseEvent::OutputItemAdded(ResponseItem::Message { role, .. })
+                if role == "assistant" => {}
+            ResponseEvent::OutputItemAdded(ResponseItem::Reasoning { .. }) => {}
+            ResponseEvent::OutputItemAdded(_) => return Err(Failure::ProviderError),
+            ResponseEvent::OutputItemDone(ResponseItem::Message { role, content, .. })
+                if role == "assistant" =>
+            {
+                for content in content {
+                    let ContentItem::OutputText { text: part, .. } = content else {
+                        return Err(Failure::ProviderError);
+                    };
+                    if text.len() + part.len() > max_output {
+                        return Err(Failure::OutputLimit);
+                    }
+                    text.push_str(&part);
+                }
+            }
+            ResponseEvent::OutputItemDone(ResponseItem::Reasoning { .. }) => {}
+            ResponseEvent::OutputItemDone(_) | ResponseEvent::ToolCallInputDelta { .. } => {
+                return Err(Failure::ProviderError);
+            }
+            ResponseEvent::Completed { end_turn, .. } => {
+                if text.is_empty() || end_turn == Some(false) {
+                    return Err(Failure::ProviderError);
+                }
+                if serde_json::to_vec(&success_value(&input.request_id, model, &text))
+                    .map_err(|_| Failure::ProviderError)?
+                    .len()
+                    + 1
+                    > max_output
+                {
+                    return Err(Failure::OutputLimit);
+                }
+                return Ok(text);
+            }
+            _ => {}
+        }
+    }
+    Err(Failure::ProviderError)
+}
