+    def _reset_admission_state(self):
+        """Reset admission and active turn metadata to idle under _admission_lock."""
+        admission_lock = getattr(self, "_admission_lock", None)
+        if admission_lock is None:
+            admission_lock = threading.RLock()
+            self._admission_lock = admission_lock
+        with admission_lock:
+            self._admission_state = "idle"
+            self._active_cancelled = False
+            self._active_request_id = None
+            self._active_delivery_id = None
+            self._active_turn_id = None
+
+    def _dequeue_pending_input(self, user_input: Any) -> Optional[Any]:
+        """Dequeue, validate, and unwrap an item from _pending_input.
+
+        Handles QueuedMessage validation against current session_id,
+        _VoiceInputMessage unwrapping, and empty filtering. Returns the
+        unwrapped payload (str or tuple) to process, or None if the item
+        should be skipped or discarded.
+        """
+        admission_lock = getattr(self, "_admission_lock", None)
+        if admission_lock is None:
+            admission_lock = threading.RLock()
+            self._admission_lock = admission_lock
+
+        with admission_lock:
+            from hermes_cli.plugins import QueuedMessage
+            if isinstance(user_input, QueuedMessage):
+                current_sid = getattr(self, "session_id", None)
+                if user_input.expected_session_id and user_input.expected_session_id != current_sid:
+                    user_input.status = "refused"
+                    user_input.refusal_reason = (
+                        f"Session mismatch: expected {user_input.expected_session_id!r}, "
+                        f"current {current_sid!r}"
+                    )
+                    user_input.consumed_session_id = current_sid
+                    self._admission_state = "idle"
+                    self._active_cancelled = False
+                    self._active_request_id = None
+                    self._active_delivery_id = None
+                    self._active_turn_id = None
+                    if user_input.on_consumed:
+                        try:
+                            user_input.on_consumed(user_input.status, current_sid)
+                        except Exception as exc:
+                            user_input.callback_error = str(exc)
+                            logger.error(
+                                "QueuedMessage on_consumed callback failed for refused message: %s",
+                                exc,
+                                exc_info=True,
+                            )
+                    logger.warning(
+                        "Discarding queued message for session %r (current session is %r)",
+                        user_input.expected_session_id,
+                        current_sid,
+                    )
+                    return None
+
+                user_input.status = "admitted"
+                user_input.consumed_session_id = current_sid
+                self._admission_state = "admitting"
+                self._active_cancelled = False
+                self._active_request_id = getattr(user_input, "request_id", None)
+                self._active_delivery_id = getattr(user_input, "delivery_id", None)
+                self._active_turn_id = (
+                    getattr(user_input, "turn_id", None)
+                    or f"{current_sid}:{current_sid}:{uuid.uuid4().hex[:8]}"
+                )
+                try:
+                    from tools.approval import _approval_request_id, _approval_turn_id
+                    _approval_request_id.set(self._active_request_id or "")
+                    _approval_turn_id.set(self._active_turn_id or "")
+                except Exception:
+                    pass
+                if getattr(self, "agent", None) is not None:
+                    self.agent._relay_pending_turn_id = self._active_turn_id
+                if user_input.on_consumed:
+                    try:
+                        user_input.on_consumed(user_input.status, current_sid)
+                    except Exception as exc:
+                        user_input.callback_error = str(exc)
+                        logger.error(
+                            "QueuedMessage on_consumed callback failed for admitted message: %s",
+                            exc,
+                            exc_info=True,
+                        )
+                user_input = user_input.text
+            else:
+                current_sid = getattr(self, "session_id", "session")
+                self._admission_state = "admitting"
+                self._active_cancelled = False
+                self._active_request_id = None
+                self._active_delivery_id = None
+                self._active_turn_id = f"{current_sid}:{current_sid}:{uuid.uuid4().hex[:8]}"
+                try:
+                    from tools.approval import _approval_request_id, _approval_turn_id
+                    _approval_request_id.set("")
+                    _approval_turn_id.set(self._active_turn_id or "")
+                except Exception:
+                    pass
+                if getattr(self, "agent", None) is not None:
+                    self.agent._relay_pending_turn_id = self._active_turn_id
+
+            if isinstance(user_input, _VoiceInputMessage):
+                user_input = user_input.text
+
+            if not user_input:
+                self._admission_state = "idle"
+                self._active_cancelled = False
+                self._active_request_id = None
+                self._active_delivery_id = None
+                self._active_turn_id = None
+                return None
+
+            return user_input
