+"""Tests for Hermes CLI queued messages exercising production seams in cli.py."""
+
+from pathlib import Path
+import queue
+from types import SimpleNamespace
+import unittest
+from unittest.mock import MagicMock
+
+from prompt_toolkit.buffer import Buffer
+
+from cli import HermesCLI, _VoiceInputMessage
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest, QueuedMessage
+
+
+def _create_cli(session_id: str = "session-original") -> HermesCLI:
+    """Create a HermesCLI instance with real buffers and queues for testing."""
+    cli = HermesCLI.__new__(HermesCLI)
+    cli.session_id = session_id
+    cli._pending_input = queue.Queue()
+    cli._interrupt_queue = queue.Queue()
+    cli._agent_running = False
+    cli._should_exit = False
+    cli._status_bar_suppressed_after_resize = False
+    cli._pending_resume_sessions = []
+    cli._pending_agent_seed = None
+    cli._interactive_turn = False
+    cli._pet_turn_error = False
+    cli._pet_reasoning = False
+    cli._spinner_text = ""
+    cli._tool_start_time = 0.0
+    cli._pending_tool_info = []
+    cli._last_scrollback_tool = ""
+    cli._last_turn_interrupted = False
+    cli._voice_mode = False
+    cli._voice_continuous = False
+    cli._voice_recording = False
+    cli._voice_tts = False
+    cli._command_running = False
+    cli._app = SimpleNamespace(
+        current_buffer=Buffer(),
+        invalidate=MagicMock(),
+        is_running=False,
+        exit=MagicMock(),
+    )
+    # UI and background bookkeeping methods called by _process_loop
+    cli._check_config_mcp_changes = MagicMock()
+    cli._check_termios_drift = MagicMock()
+    cli._drain_process_notifications = MagicMock()
+    cli._maybe_fire_loop_tick = MagicMock()
+    cli._turn_summary_begin = MagicMock()
+    cli._turn_summary_emit = MagicMock()
+    cli._pet_react_turn_end = MagicMock()
+    cli._print_user_message_preview = MagicMock()
+    cli._recover_terminal_after_interrupt = MagicMock()
+    cli._drain_interrupt_queue_to_pending_input = MagicMock()
+    cli._maybe_continue_goal_after_turn = MagicMock()
+    cli._maybe_complete_loop_tick_after_turn = MagicMock()
+    cli._typed_voice_stop = MagicMock(return_value=False)
+    cli.handle_bang_shell = MagicMock(return_value=False)
+    cli.process_command = MagicMock(return_value=True)
+    return cli
+
+
+class TestHermesQueueSeam(unittest.TestCase):
+    """Unit tests for production queue seam methods in cli.py."""
+
+    def test_production_dequeue_admitted_matching_session(self):
+        """Production seam: matching session marks 'admitted' and unwraps text."""
+        cli = _create_cli(session_id="session-matching")
+        callback = MagicMock()
+        qm = QueuedMessage(
+            text="wake instruction",
+            expected_session_id="session-matching",
+            on_consumed=callback,
+        )
+
+        result = cli._dequeue_pending_input(qm)
+
+        self.assertEqual(result, "wake instruction")
+        self.assertEqual(qm.status, "admitted")
+        self.assertEqual(qm.consumed_session_id, "session-matching")
+        self.assertIsNone(qm.refusal_reason)
+        callback.assert_called_once_with("admitted", "session-matching")
+
+    def test_production_dequeue_refuses_on_changed_session(self):
+        """Production seam: session mismatch (e.g. /resume) marks 'refused' and discards."""
+        cli = _create_cli(session_id="session-switched")
+        callback = MagicMock()
+        qm = QueuedMessage(
+            text="wake instruction",
+            expected_session_id="session-original",
+            on_consumed=callback,
+        )
+
+        result = cli._dequeue_pending_input(qm)
+
+        # Must be discarded (None) so process_loop skips execution
+        self.assertIsNone(result)
+        self.assertEqual(qm.status, "refused")
+        self.assertEqual(qm.consumed_session_id, "session-switched")
+        self.assertIn("Session mismatch", qm.refusal_reason)
+        self.assertIn("session-original", qm.refusal_reason)
+        self.assertIn("session-switched", qm.refusal_reason)
+        callback.assert_called_once_with("refused", "session-switched")
+
+    def test_composer_buffer_preserved_through_queue_consumption(self):
+        """Unsubmitted human typing in real prompt_toolkit Buffer is never cleared by dequeue."""
+        cli = _create_cli(session_id="session-active")
+        # Simulate user in the middle of typing a draft in prompt_toolkit
+        cli._app.current_buffer.text = "half written user draft"
+        cli._app.current_buffer.cursor_position = len("half written user draft")
+
+        qm = QueuedMessage(text="background wake", expected_session_id="session-active")
+        result = cli._dequeue_pending_input(qm)
+
+        self.assertEqual(result, "background wake")
+        # Crucial guarantee: composer buffer remains intact
+        self.assertEqual(cli._app.current_buffer.text, "half written user draft")
+        self.assertEqual(cli._app.current_buffer.cursor_position, len("half written user draft"))
+
+    def test_busy_ordering_never_preempts_or_interrupts(self):
+        """PluginContext.queue_message queues serially without entering _interrupt_queue."""
+        cli = _create_cli(session_id="session-busy")
+        cli._agent_running = True  # Agent actively executing tools
+
+        manager = PluginManager()
+        manifest = PluginManifest(name="cairn-plugin", key="cairn", source="user")
+        ctx = PluginContext(manifest, manager)
+        manager._cli_ref = cli
+
+        qm = ctx.queue_message("wake while busy", expected_session_id="session-busy")
+
+        self.assertIsNotNone(qm)
+        self.assertTrue(cli._interrupt_queue.empty(), "Wake message must never enter _interrupt_queue")
+        self.assertFalse(cli._pending_input.empty(), "Wake message must be queued in _pending_input")
+        queued_item = cli._pending_input.get_nowait()
+        self.assertIs(queued_item, qm)
+
+    def test_callback_exception_recorded_without_crashing_cli(self):
+        """Exceptions inside on_consumed callback are captured in callback_error."""
+        cli = _create_cli(session_id="session-err")
+
+        def faulty_callback(status, sid):
+            raise RuntimeError("simulated subscriber persistence error")
+
+        qm = QueuedMessage(
+            text="wake",
+            expected_session_id="session-err",
+            on_consumed=faulty_callback,
+        )
+
+        result = cli._dequeue_pending_input(qm)
+
+        self.assertEqual(result, "wake")
+        self.assertEqual(qm.status, "admitted")
+        self.assertEqual(qm.callback_error, "simulated subscriber persistence error")
+
+    def test_normal_inputs_pass_through_unmodified(self):
+        """Strings, image tuples, and voice messages pass through _dequeue_pending_input."""
+        cli = _create_cli(session_id="session-normal")
+
+        # String
+        self.assertEqual(cli._dequeue_pending_input("hello world"), "hello world")
+
+        # Image tuple
+        image_tuple = ("analyze this", [Path("/tmp/test.png")])
+        self.assertEqual(cli._dequeue_pending_input(image_tuple), image_tuple)
+
+        # Voice input
+        voice = _VoiceInputMessage("transcribed audio prompt")
+        self.assertEqual(cli._dequeue_pending_input(voice), "transcribed audio prompt")
+
+        # Empty inputs filtered
+        self.assertIsNone(cli._dequeue_pending_input(""))
+        self.assertIsNone(cli._dequeue_pending_input(None))
+
+
+class TestProcessLoopEndToEnd(unittest.TestCase):
+    """Regression tests executing HermesCLI._process_loop end-to-end through chat dispatch."""
+
+    def test_process_loop_normal_text_dispatches_with_voice_false(self):
+        """Normal text passes through _process_loop to chat with voice_input=False."""
+        cli = _create_cli(session_id="session-text")
+        dispatched = []
+
+        def mock_chat(user_input, images=None, voice_input=False):
+            dispatched.append({"input": user_input, "images": images, "voice": voice_input})
+            cli._should_exit = True
+
+        cli.chat = mock_chat
+        cli._pending_input.put("hello from human")
+
+        cli._process_loop(cli._app)
+
+        self.assertEqual(len(dispatched), 1)
+        self.assertEqual(dispatched[0]["input"], "hello from human")
+        self.assertFalse(dispatched[0]["voice"])
+        self.assertIsNone(dispatched[0]["images"])
+
+    def test_process_loop_voice_input_preserves_voice_flag_through_chat(self):
+        """_VoiceInputMessage preserves voice_input=True flag in self.chat dispatch.
+
+        Guards against regression where _dequeue_pending_input unwrapped text
+        without setting is_voice_input before the typed-voice check / chat dispatch.
+        """
+        cli = _create_cli(session_id="session-voice")
+        dispatched = []
+
+        def mock_chat(user_input, images=None, voice_input=False):
+            dispatched.append({"input": user_input, "images": images, "voice": voice_input})
+            cli._should_exit = True
+
+        cli.chat = mock_chat
+        cli._pending_input.put(_VoiceInputMessage("spoken instruction from mic"))
+
+        cli._process_loop(cli._app)
+
+        self.assertEqual(len(dispatched), 1)
+        self.assertEqual(dispatched[0]["input"], "spoken instruction from mic")
+        self.assertTrue(dispatched[0]["voice"], "voice_input flag must be True for _VoiceInputMessage")
+
+    def test_process_loop_queued_wake_admitted_and_composer_preserved(self):
+        """QueuedMessage passes through _process_loop, executes chat, and preserves composer buffer."""
+        cli = _create_cli(session_id="session-wake")
+        cli._app.current_buffer.text = "unsubmitted human draft typed in terminal"
+        cli._app.current_buffer.cursor_position = len(cli._app.current_buffer.text)
+
+        callback = MagicMock()
+        qm = QueuedMessage(
+            text="autonomous wake instruction",
+            expected_session_id="session-wake",
+            on_consumed=callback,
+        )
+        cli._pending_input.put(qm)
+
+        dispatched = []
+
+        def mock_chat(user_input, images=None, voice_input=False):
+            dispatched.append({"input": user_input, "voice": voice_input})
+            cli._should_exit = True
+
+        cli.chat = mock_chat
+
+        cli._process_loop(cli._app)
+
+        # 1. Chat dispatched with unwrapped text
+        self.assertEqual(len(dispatched), 1)
+        self.assertEqual(dispatched[0]["input"], "autonomous wake instruction")
+        self.assertFalse(dispatched[0]["voice"])
+
+        # 2. QueuedMessage marked admitted and callback notified
+        self.assertEqual(qm.status, "admitted")
+        self.assertEqual(qm.consumed_session_id, "session-wake")
+        callback.assert_called_once_with("admitted", "session-wake")
+
+        # 3. User composer buffer was untouched throughout loop execution
+        self.assertEqual(cli._app.current_buffer.text, "unsubmitted human draft typed in terminal")
+        self.assertEqual(cli._app.current_buffer.cursor_position, len("unsubmitted human draft typed in terminal"))
+
+    def test_process_loop_mismatched_session_refused_without_chat_dispatch(self):
+        """QueuedMessage with mismatched expected session is refused and skipped in _process_loop."""
+        cli = _create_cli(session_id="session-active-now")
+        callback = MagicMock()
+        qm = QueuedMessage(
+            text="stale wake for earlier session",
+            expected_session_id="session-stale",
+            on_consumed=callback,
+        )
