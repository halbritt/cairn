index 0000000..819ee3f
--- /dev/null
+++ b/codex-rs/core/src/owner_input.rs
@@ -0,0 +1,118 @@
+//! Only Core's accepted-input branch grants a fresh owner-turn observation.
+
+use codex_protocol::owner_input::{OwnerInputAdmission, OwnerInputOrigin, OwnerInputSource};
+use std::collections::HashSet;
+use std::sync::{Mutex, OnceLock};
+use uuid::Uuid;
+
+const MAX_INPUTS: usize = 65_536;
+static ACCEPTED: OnceLock<Mutex<AcceptedInputs>> = OnceLock::new();
+
+#[derive(Default)]
+struct AcceptedInputs(HashSet<Uuid>);
+
+impl AcceptedInputs {
+    fn admit(
+        &mut self,
+        input_id: Option<Uuid>,
+        admission: OwnerInputAdmission,
+    ) -> OwnerInputOrigin {
+        let Some(id) = input_id.filter(|id| !id.is_nil()) else {
+            return OwnerInputOrigin::default();
+        };
+        let admission = if self.0.contains(&id) {
+            OwnerInputAdmission::Recovery
+        } else if self.0.len() == MAX_INPUTS {
+            // Never evict a prior identity into fresh eligibility.
+            OwnerInputAdmission::Unknown
+        } else {
+            self.0.insert(id);
+            admission
+        };
+        OwnerInputOrigin {
+            version: 1,
+            source: OwnerInputSource::OwnerComposer,
+            admission,
+            input_id: Some(id),
+        }
+    }
+}
+
+pub(crate) fn admit(input_id: Option<Uuid>, admission: OwnerInputAdmission) -> OwnerInputOrigin {
+    ACCEPTED
+        .get_or_init(Mutex::default)
+        .lock()
+        .expect("owner-input registry poisoned")
+        .admit(input_id, admission)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn replay_cannot_become_fresh_after_join_or_thread_change() {
+        let mut accepted = AcceptedInputs::default();
+        let id = Uuid::new_v4();
+        assert_eq!(
+            accepted
+                .admit(Some(id), OwnerInputAdmission::Joined)
+                .admission,
+            OwnerInputAdmission::Joined
+        );
+        assert_eq!(
+            accepted
+                .admit(Some(id), OwnerInputAdmission::FreshStart)
+                .admission,
+            OwnerInputAdmission::Recovery
+        );
+        assert_eq!(
+            accepted.admit(None, OwnerInputAdmission::FreshStart),
+            OwnerInputOrigin::default()
+        );
+    }
+
+    #[test]
+    fn saturation_retains_old_identity_and_refuses_new_fresh_observations() {
+        let mut accepted = AcceptedInputs((1..=MAX_INPUTS as u128).map(Uuid::from_u128).collect());
+        assert_eq!(
+            accepted
+                .admit(Some(Uuid::from_u128(1)), OwnerInputAdmission::FreshStart)
+                .admission,
+            OwnerInputAdmission::Recovery
+        );
+        assert_eq!(
+            accepted
+                .admit(
+                    Some(Uuid::from_u128(MAX_INPUTS as u128 + 1)),
+                    OwnerInputAdmission::FreshStart
+                )
+                .admission,
+            OwnerInputAdmission::Unknown
+        );
+        assert_eq!(accepted.0.len(), MAX_INPUTS);
+    }
+}
+
+#[cfg(test)]
+mod recovery_tests {
+    use super::*;
+
+    #[test]
+    fn serialized_metadata_cannot_restore_owner_authority() {
+        let metadata = crate::session::UserInputMetadata {
+            owner_input_origin: OwnerInputOrigin {
+                version: 1,
+                source: OwnerInputSource::OwnerComposer,
+                admission: OwnerInputAdmission::FreshStart,
+                input_id: Some(Uuid::new_v4()),
+            },
+            ..Default::default()
+        };
+        let mut value = serde_json::to_value(metadata).unwrap();
+        assert!(value.get("owner_input_origin").is_none());
+        value["owner_input_origin"] = serde_json::to_value(metadata.owner_input_origin).unwrap();
+        let restored: crate::session::UserInputMetadata = serde_json::from_value(value).unwrap();
+        assert_eq!(restored.owner_input_origin, OwnerInputOrigin::default());
+    }
+}
