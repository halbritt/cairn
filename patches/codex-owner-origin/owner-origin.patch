diff --git a/codex-rs/app-server-transport/src/owner_ingress.rs b/codex-rs/app-server-transport/src/owner_ingress.rs
new file mode 100644
index 0000000..9e39dd6
--- /dev/null
+++ b/codex-rs/app-server-transport/src/owner_ingress.rs
@@ -0,0 +1,252 @@
+//! Per-launch owner-connection proof. Public RPC fields cannot establish this trust.
+
+use std::io::{self, Read};
+use std::sync::OnceLock;
+
+pub const HEADER: &str = "x-codex-owner-ingress-v1";
+pub const CONTRACT: &str = "codex.owner-input/1";
+pub const BASE_COMMIT: &str = "6ff1e1ca3b30fc8b914720681fcf5fe62e95f856";
+const MAGIC: &[u8] = b"CAIRN-OWNER-INPUT/1\n";
+static PROOF: OnceLock<OwnerIngressProof> = OnceLock::new();
+
+pub struct OwnerIngressProof {
+    secret: [u8; 32],
+    endpoint: Vec<u8>,
+}
+
+impl std::fmt::Debug for OwnerIngressProof {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("OwnerIngressProof([REDACTED])")
+    }
+}
+
+impl OwnerIngressProof {
+    fn read(reader: &mut impl Read) -> io::Result<Self> {
+        let mut bytes = Vec::new();
+        reader
+            .take((MAGIC.len() + 32 + 1 + 108) as u64)
+            .read_to_end(&mut bytes)?;
+        let prefix = MAGIC.len() + 32 + 1;
+        if bytes.len() < prefix || !bytes.starts_with(MAGIC) {
+            bytes.fill(0);
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "invalid owner-ingress proof frame",
+            ));
+        }
+        let length = usize::from(bytes[prefix - 1]);
+        if length == 0
+            || length > 107
+            || bytes.len() != prefix + length
+            || bytes[prefix] != b'/'
+            || bytes[prefix..].contains(&0)
+        {
+            bytes.fill(0);
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "invalid owner-ingress endpoint",
+            ));
+        }
+        let mut secret = [0; 32];
+        secret.copy_from_slice(&bytes[MAGIC.len()..MAGIC.len() + 32]);
+        let endpoint = bytes[prefix..].to_vec();
+        bytes.fill(0);
+        Ok(Self { secret, endpoint })
+    }
+
+    pub fn for_endpoint(&self, endpoint: &std::path::Path) -> bool {
+        #[cfg(unix)]
+        {
+            use std::os::unix::ffi::OsStrExt;
+            endpoint.as_os_str().as_bytes() == self.endpoint
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = endpoint;
+            false
+        }
+    }
+
+    pub fn header_value(&self) -> String {
+        self.secret
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect()
+    }
+
+    pub fn matches(&self, header: &[u8]) -> bool {
+        let expected = self.header_value();
+        constant_time_eq::constant_time_eq(header, expected.as_bytes())
+    }
+}
+
+pub fn proof() -> Option<&'static OwnerIngressProof> {
+    PROOF.get()
+}
+
+/// Takes ownership of an inherited Unix socket and closes it before returning.
+/// The launcher closes its writer; malformed or still-open peers time out.
+#[cfg(unix)]
+pub fn initialize_from_fd(fd: i32) -> io::Result<()> {
+    use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+    use std::os::unix::fs::FileTypeExt;
+    use std::os::unix::net::UnixStream;
+    if fd < 3 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "owner-ingress descriptor must not be stdio",
+        ));
+    }
+    // Validate the descriptor before constructing an owning Rust handle. Also set
+    // CLOEXEC immediately: the secret channel must never reach a tool subprocess.
+    if unsafe { libc::fcntl(fd, libc::F_GETFD) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: this startup-only operation consumes the validated inherited descriptor.
+    let owned = unsafe { OwnedFd::from_raw_fd(fd) };
+    let file = std::fs::File::from(owned);
+    if !file.metadata()?.file_type().is_socket() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "owner-ingress descriptor is not a socket",
+        ));
+    }
+    let mut socket = UnixStream::from(OwnedFd::from(file));
+    let mut socket_type: libc::c_int = 0;
+    let mut size = std::mem::size_of_val(&socket_type) as libc::socklen_t;
+    // SAFETY: both output pointers refer to initialized, correctly sized values.
+    if unsafe {
+        libc::getsockopt(
+            socket.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_TYPE,
+            std::ptr::from_mut(&mut socket_type).cast(),
+            &mut size,
+        )
+    } < 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    if socket_type != libc::SOCK_STREAM
+        || !socket.local_addr()?.is_unnamed()
+        || !socket.peer_addr()?.is_unnamed()
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "owner-ingress descriptor must be a private Unix stream pair",
+        ));
+    }
+    let mut reader = DeadlineProofReader {
+        socket: &mut socket,
+        deadline: std::time::Instant::now() + std::time::Duration::from_millis(250),
+    };
+    let proof = OwnerIngressProof::read(&mut reader)?;
+    PROOF.set(proof).map_err(|_| {
+        io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "owner-ingress proof already initialized",
+        )
+    })
+}
+
+#[cfg(unix)]
+struct DeadlineProofReader<'a> {
+    socket: &'a mut std::os::unix::net::UnixStream,
+    deadline: std::time::Instant,
+}
+
+#[cfg(unix)]
+impl Read for DeadlineProofReader<'_> {
+    fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+        let remaining = self
+            .deadline
+            .saturating_duration_since(std::time::Instant::now());
+        if remaining.is_zero() {
+            return Err(io::Error::new(
+                io::ErrorKind::TimedOut,
+                "owner-ingress proof deadline exceeded",
+            ));
+        }
+        self.socket.set_read_timeout(Some(remaining))?;
+        self.socket.read(bytes)
+    }
+}
+
+#[cfg(not(unix))]
+pub fn initialize_from_fd(_fd: i32) -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "owner ingress requires a Unix launcher",
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn proof_is_exact_bounded_and_redacted() {
+        let frame = [MAGIC, &[0x42; 32], &[6], b"/owned"].concat();
+        let proof = OwnerIngressProof::read(&mut &frame[..]).unwrap();
+        assert!(proof.for_endpoint(std::path::Path::new("/owned")));
+        assert!(!proof.for_endpoint(std::path::Path::new("/other")));
+        assert!(proof.matches("42".repeat(32).as_bytes()));
+        assert!(!proof.matches("43".repeat(32).as_bytes()));
+        assert!(!proof.matches(b"42"));
+        assert_eq!(format!("{proof:?}"), "OwnerIngressProof([REDACTED])");
+        for invalid in [
+            &frame[..frame.len() - 1],
+            &[frame.clone(), vec![0]].concat(),
+            &[0; 1000],
+        ] {
+            assert!(OwnerIngressProof::read(&mut &invalid[..]).is_err());
+        }
+    }
+}
+
+#[cfg(all(test, unix))]
+mod descriptor_tests {
+    use super::*;
+    use std::os::fd::IntoRawFd;
+
+    #[test]
+    fn invalid_and_stdio_descriptors_are_refused() {
+        for descriptor in [-1, 0, 1, 2, i32::MAX] {
+            assert!(initialize_from_fd(descriptor).is_err());
+        }
+        assert!(unsafe { libc::fcntl(1, libc::F_GETFD) } >= 0);
+    }
+
+    #[test]
+    fn trickled_frame_cannot_extend_absolute_deadline() {
+        use std::io::Write;
+        let (reader, mut writer) = std::os::unix::net::UnixStream::pair().unwrap();
+        let descriptor = reader.into_raw_fd();
+        let sender = std::thread::spawn(move || {
+            for _ in 0..20 {
+                if writer.write_all(b"C").is_err() {
+                    break;
+                }
+                std::thread::sleep(std::time::Duration::from_millis(50));
+            }
+        });
+        let started = std::time::Instant::now();
+        assert!(initialize_from_fd(descriptor).is_err());
+        assert!(started.elapsed() < std::time::Duration::from_millis(750));
+        assert_eq!(unsafe { libc::fcntl(descriptor, libc::F_GETFD) }, -1);
+        sender.join().unwrap();
+    }
+
+    #[test]
+    fn stalled_proof_reader_is_bounded_and_closes_descriptor() {
+        let (reader, _writer) = std::os::unix::net::UnixStream::pair().unwrap();
+        let descriptor = reader.into_raw_fd();
+        let started = std::time::Instant::now();
+        assert!(initialize_from_fd(descriptor).is_err());
+        assert!(started.elapsed() < std::time::Duration::from_secs(2));
+        assert_eq!(unsafe { libc::fcntl(descriptor, libc::F_GETFD) }, -1);
+    }
+}
