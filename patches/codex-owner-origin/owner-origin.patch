+        chat.input_queue
+            .rejected_steer_history_records
+            .push_back(UserMessageHistoryRecord::UserMessageText);
+    }
+    for id in ids {
+        let (queued, _) = chat.pop_next_queued_user_message().expect("separate input");
+        assert_eq!(queued.source.owner_input_id(), Some(id));
+        assert_eq!(queued.user_message.text, "retry");
+    }
+    assert!(chat.pop_next_queued_user_message().is_none());
+}
+
+#[tokio::test]
+async fn owner_composer_reconnect_keeps_unsent_uuid_and_does_not_mint_replay_identity() {
+    let (mut chat, _, mut operations) = make_chatwidget_manual(None).await;
+    let thread = ThreadId::new();
+    chat.thread_id = Some(thread);
+    handle_turn_started(&mut chat, "active");
+    chat.apply_external_edit("owner input after reconnect".into());
+    chat.handle_key_event(KeyCode::Tab.into());
+    let original = chat
+        .input_queue
+        .queued_user_messages
+        .front()
+        .unwrap()
+        .source
+        .owner_input_id()
+        .unwrap();
+    assert_no_submit_op(&mut operations);
+    chat.pause_for_disconnect();
+    let saved = chat.capture_thread_input_state();
+    let (mut restored, _, mut restored_operations) = make_chatwidget_manual(None).await;
+    restored.thread_id = Some(thread);
+    restored.restore_reconnected_input(saved, &[]);
+    assert!(restored.maybe_send_next_queued_input());
+    assert_matches!(next_submit_op(&mut restored_operations), Op::UserTurn { owner_input_id: Some(id), .. } if id == original);
+}
