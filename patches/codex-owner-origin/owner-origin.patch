+#[tokio::test]
+async fn owner_composer_identity_requires_physical_submission() {
+    let (mut chat, _, mut operations) = make_chatwidget_manual(None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.apply_external_edit("same text".to_string());
+    chat.handle_key_event(KeyCode::Enter.into());
+    let Op::UserTurn {
+        owner_input_id: Some(first),
+        ..
+    } = next_submit_op(&mut operations)
+    else {
+        panic!("physical composer must carry an identity");
+    };
+    assert!(!first.is_nil());
+    handle_turn_started(&mut chat, "first");
+    handle_turn_completed(&mut chat, "first", None);
+    // This is also the entry used by automatic startup draft replay.
+    chat.handle_composer_input_result(
+        InputResult::Submitted {
+            text: "same text".to_string(),
+            text_elements: Vec::new(),
+        },
+        false,
+    );
+    assert_matches!(
+        next_submit_op(&mut operations),
+        Op::UserTurn {
+            owner_input_id: None,
+            ..
+        }
+    );
+}
+
+#[tokio::test]
+async fn owner_composer_queue_preserves_identity_until_native_admission() {
+    let (mut chat, _, mut operations) = make_chatwidget_manual(None).await;
+    chat.thread_id = Some(ThreadId::new());
+    handle_turn_started(&mut chat, "running");
+    chat.apply_external_edit("queued owner input".to_string());
+    chat.handle_key_event(KeyCode::Tab.into());
+    let queued = chat
+        .input_queue
+        .queued_user_messages
+        .front()
+        .expect("queued input");
+    let id = queued
+        .source
+        .owner_input_id()
+        .expect("physical queue identity");
+    assert_no_submit_op(&mut operations);
+    handle_turn_completed(&mut chat, "running", None);
+    assert_matches!(next_submit_op(&mut operations), Op::UserTurn { owner_input_id: Some(sent), .. } if sent == id);
+}
