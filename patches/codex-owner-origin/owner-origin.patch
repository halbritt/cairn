new file mode 100644
index 0000000..1a78821
--- /dev/null
+++ b/codex-rs/core/src/owner_input_attestation.rs
@@ -0,0 +1,340 @@
+//! Ephemeral native hook attestations; the signing key never enters hook input.
+
+use base64::Engine;
+use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+use codex_protocol::owner_input::{OwnerInputAttestation, OwnerInputOrigin};
+use ed25519_dalek::{Signer, SigningKey};
+use serde::Serialize;
+use std::io::{self, Read, Write};
+use std::sync::OnceLock;
+use uuid::Uuid;
+
+pub const CONTRACT: &str = "cairn.owner-input-attestation/1";
+const DOMAIN: &[u8] = b"cairn.owner-input-attestation/1\n";
+const MAGIC: &[u8] = b"CAIRN-OWNER-ATTESTATION/1\n";
+static SIGNER: OnceLock<OwnerInputSigner> = OnceLock::new();
+
+struct OwnerInputSigner {
+    launch_id: Uuid,
+    restore_generation: i64,
+    key: SigningKey,
+}
+
+#[derive(Serialize)]
+struct Payload<'a> {
+    launch_id: Uuid,
+    restore_generation: i64,
+    issued_at_unix_ms: i64,
+    native_session_id: &'a str,
+    native_turn_id: &'a str,
+    origin_contract: &'static str,
+    origin_version: u8,
+    source: codex_protocol::owner_input::OwnerInputSource,
+    admission: codex_protocol::owner_input::OwnerInputAdmission,
+    input_id: Option<Uuid>,
+}
+
+impl OwnerInputSigner {
+    fn attest(
+        &self,
+        session: &str,
+        turn: &str,
+        origin: OwnerInputOrigin,
+        issued_at_unix_ms: i64,
+    ) -> OwnerInputAttestation {
+        let payload = serde_json::to_vec(&Payload {
+            launch_id: self.launch_id,
+            restore_generation: self.restore_generation,
+            issued_at_unix_ms,
+            native_session_id: session,
+            native_turn_id: turn,
+            origin_contract: "codex.owner-input/1",
+            origin_version: origin.version,
+            source: origin.source,
+            admission: origin.admission,
+            input_id: origin.input_id,
+        })
+        .expect("owner-input attestation contains only serializable scalar fields");
+        let mut signed = Vec::with_capacity(DOMAIN.len() + payload.len());
+        signed.extend_from_slice(DOMAIN);
+        signed.extend_from_slice(&payload);
+        OwnerInputAttestation {
+            schema: CONTRACT.to_string(),
+            payload: URL_SAFE_NO_PAD.encode(&payload),
+            signature: URL_SAFE_NO_PAD.encode(self.key.sign(&signed).to_bytes()),
+        }
+    }
+}
+
+pub(crate) fn attest(
+    session: &str,
+    turn: &str,
+    origin: OwnerInputOrigin,
+) -> Option<OwnerInputAttestation> {
+    let issued_at_unix_ms = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .ok()?
+        .as_millis()
+        .try_into()
+        .ok()?;
+    SIGNER
+        .get()
+        .map(|signer| signer.attest(session, turn, origin, issued_at_unix_ms))
+}
+
+/// Startup-only private channel. Operator registration returns the Store's
+/// generation before the signer is enabled or any hook/tool can run.
+#[cfg(unix)]
+pub fn initialize_from_fd(fd: i32) -> io::Result<()> {
+    let signer = receive_signer(fd, std::time::Duration::from_secs(15))?;
+    SIGNER.set(signer).map_err(|_| {
+        io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "owner-input signer already initialized",
+        )
+    })
+}
+
+#[cfg(not(unix))]
+pub fn initialize_from_fd(_fd: i32) -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "owner-input attestation requires a Unix launcher",
+    ))
+}
+
+#[cfg(unix)]
+fn receive_signer(fd: i32, timeout: std::time::Duration) -> io::Result<OwnerInputSigner> {
+    use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+    use std::os::unix::fs::FileTypeExt;
+    use std::os::unix::net::UnixStream;
+    if fd < 3 || unsafe { libc::fcntl(fd, libc::F_GETFD) } < 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid owner-input signing descriptor",
+        ));
+    }
+    // SAFETY: this startup operation consumes the validated inherited descriptor.
+    let owned = unsafe { OwnedFd::from_raw_fd(fd) };
+    if unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let file = std::fs::File::from(owned);
+    if !file.metadata()?.file_type().is_socket() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "owner-input signing descriptor is not a socket",
+        ));
+    }
+    let socket = UnixStream::from(OwnedFd::from(file));
+    let mut socket_type: libc::c_int = 0;
+    let mut size = std::mem::size_of_val(&socket_type) as libc::socklen_t;
+    // SAFETY: both outputs are initialized values with the specified size.
+    if unsafe {
+        libc::getsockopt(
+            socket.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_TYPE,
+            std::ptr::from_mut(&mut socket_type).cast(),
+            &mut size,
+        )
+    } < 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    if socket_type != libc::SOCK_STREAM
+        || !socket.local_addr()?.is_unnamed()
+        || !socket.peer_addr()?.is_unnamed()
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "owner-input signing descriptor must be a private Unix stream pair",
+        ));
+    }
+    let mut channel = DeadlineChannel {
+        socket,
+        deadline: std::time::Instant::now() + timeout,
+    };
+    let mut magic = [0; MAGIC.len()];
+    let mut launch = [0; 16];
+    let mut seed = [0; 32];
+    channel.read_exact(&mut magic)?;
+    channel.read_exact(&mut launch)?;
+    channel.read_exact(&mut seed)?;
+    let launch_id = Uuid::from_bytes(launch);
+    if magic != MAGIC || launch_id.is_nil() {
+        seed.fill(0);
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid owner-input signing frame",
+        ));
+    }
+    let key = SigningKey::from_bytes(&seed);
+    seed.fill(0);
+    channel.write_all(&key.verifying_key().to_bytes())?;
+    let mut generation = [0; 8];
+    channel.read_exact(&mut generation)?;
+    let restore_generation = i64::from_be_bytes(generation);
+    let mut extra = [0];
+    if restore_generation < 0 || channel.read(&mut extra)? != 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid owner-input signing generation acknowledgement",
+        ));
+    }
+    Ok(OwnerInputSigner {
+        launch_id,
+        restore_generation,
+        key,
+    })
+}
+
+#[cfg(unix)]
+struct DeadlineChannel {
+    socket: std::os::unix::net::UnixStream,
+    deadline: std::time::Instant,
+}
+
+#[cfg(unix)]
+impl DeadlineChannel {
+    fn remaining(&self) -> io::Result<std::time::Duration> {
+        let remaining = self
+            .deadline
+            .saturating_duration_since(std::time::Instant::now());
+        if remaining.is_zero() {
+            return Err(io::Error::new(
+                io::ErrorKind::TimedOut,
+                "owner-input signing handshake deadline exceeded",
+            ));
+        }
+        Ok(remaining)
+    }
+}
+
+#[cfg(unix)]
+impl Read for DeadlineChannel {
+    fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+        self.socket.set_read_timeout(Some(self.remaining()?))?;
+        self.socket.read(bytes)
+    }
+}
+
+#[cfg(unix)]
+impl Write for DeadlineChannel {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.socket.set_write_timeout(Some(self.remaining()?))?;
+        self.socket.write(bytes)
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        self.socket.flush()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::owner_input::{OwnerInputAdmission, OwnerInputSource};
+    use ed25519_dalek::{Signature, Verifier};
+
+    #[test]
+    fn signature_binds_exact_native_observation_without_prompt_or_key() {
+        let signer = OwnerInputSigner {
+            launch_id: Uuid::new_v4(),
+            restore_generation: 7,
+            key: SigningKey::from_bytes(&[42; 32]),
+        };
+        for admission in [
+            OwnerInputAdmission::FreshStart,
+            OwnerInputAdmission::Joined,
+            OwnerInputAdmission::Recovery,
+            OwnerInputAdmission::Unknown,
+        ] {
+            let origin = OwnerInputOrigin {
+                version: 1,
+                source: OwnerInputSource::OwnerComposer,
+                admission,
+                input_id: Some(Uuid::new_v4()),
+            };
+            let envelope =
+                signer.attest("native-session", "native-turn", origin, 1_700_000_000_000);
+            let payload = URL_SAFE_NO_PAD.decode(envelope.payload).unwrap();
+            let signature =
+                Signature::from_slice(&URL_SAFE_NO_PAD.decode(envelope.signature).unwrap())
+                    .unwrap();
+            let mut message = [DOMAIN, &payload].concat();
+            signer
+                .key
+                .verifying_key()
+                .verify(&message, &signature)
+                .unwrap();
+            message[DOMAIN.len()] ^= 1;
+            assert!(
+                signer
+                    .key
+                    .verifying_key()
+                    .verify(&message, &signature)
+                    .is_err()
+            );
+            let body: serde_json::Value = serde_json::from_slice(&payload).unwrap();
+            assert_eq!(body["native_session_id"], "native-session");
+            assert_eq!(body["native_turn_id"], "native-turn");
+            assert_eq!(body["restore_generation"], 7);
+            assert_eq!(body["input_id"], origin.input_id.unwrap().to_string());
+            assert_eq!(body["issued_at_unix_ms"], 1_700_000_000_000i64);
+            assert_eq!(body.as_object().unwrap().len(), 10);
+        }
+        let unknown = signer.attest(
+            "session",
+            "turn",
+            OwnerInputOrigin::default(),
+            1_700_000_000_000,
+        );
+        let body: serde_json::Value =
+            serde_json::from_slice(&URL_SAFE_NO_PAD.decode(unknown.payload).unwrap()).unwrap();
+        assert_eq!(body["source"], "unknown");
+        assert!(body["input_id"].is_null());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn private_signer_channel_requires_generation_ack_and_closes() {
+        use std::os::fd::IntoRawFd;
+        use std::os::unix::net::UnixStream;
+        let (native, mut launcher) = UnixStream::pair().unwrap();
+        let fd = native.into_raw_fd();
+        let launch = Uuid::new_v4();
+        let worker =
+            std::thread::spawn(move || receive_signer(fd, std::time::Duration::from_secs(1)));
+        launcher
+            .write_all(&[MAGIC, launch.as_bytes(), &[42; 32]].concat())
+            .unwrap();
+        let mut public = [0; 32];
+        launcher.read_exact(&mut public).unwrap();
+        assert_eq!(
+            public,
+            SigningKey::from_bytes(&[42; 32]).verifying_key().to_bytes()
+        );
+        launcher.write_all(&7i64.to_be_bytes()).unwrap();
+        launcher.shutdown(std::net::Shutdown::Write).unwrap();
+        let signer = worker.join().unwrap().unwrap();
+        assert_eq!(signer.launch_id, launch);
+        assert_eq!(signer.restore_generation, 7);
+        assert_eq!(unsafe { libc::fcntl(fd, libc::F_GETFD) }, -1);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn missing_operator_ack_and_invalid_descriptor_never_install_signer() {
+        use std::os::fd::IntoRawFd;
+        for fd in [-1, 0, 1, 2, i32::MAX] {
+            assert!(receive_signer(fd, std::time::Duration::from_millis(50)).is_err());
+        }
+        let (native, mut launcher) = std::os::unix::net::UnixStream::pair().unwrap();
+        let fd = native.into_raw_fd();
+        launcher
+            .write_all(&[MAGIC, Uuid::new_v4().as_bytes(), &[1; 32]].concat())
+            .unwrap();
+        assert!(receive_signer(fd, std::time::Duration::from_millis(50)).is_err());
+        assert_eq!(unsafe { libc::fcntl(fd, libc::F_GETFD) }, -1);
+    }
+}
