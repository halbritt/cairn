+
+    #[derive(Clone)]
+    struct TraceCapture(Arc<Mutex<Vec<u8>>>);
+    impl Write for TraceCapture {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0.lock().unwrap().extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    #[tokio::test]
+    async fn owner_ingress_authenticates_only_private_connection_and_redacts_both_handshakes() {
+        let directory = tempfile::tempdir().unwrap();
+        std::fs::set_permissions(directory.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+        let endpoint =
+            AbsolutePathBuf::from_absolute_path(directory.path().join("owner.sock")).unwrap();
+        let mut secret = [0; 32];
+        std::fs::File::open("/dev/urandom")
+            .unwrap()
+            .read_exact(&mut secret)
+            .unwrap();
+        let (reader, mut writer) = std::os::unix::net::UnixStream::pair().unwrap();
+        let path = endpoint.to_string_lossy();
+        writer.write_all(b"CAIRN-OWNER-INPUT/1\n").unwrap();
+        writer.write_all(&secret).unwrap();
+        writer.write_all(&[path.len() as u8]).unwrap();
+        writer.write_all(path.as_bytes()).unwrap();
+        drop(writer);
+        codex_app_server_transport::owner_ingress::initialize_from_fd(reader.into_raw_fd())
+            .unwrap();
+        let capture = TraceCapture(Arc::default());
+        let captured = capture.0.clone();
+        let subscriber = tracing_subscriber::fmt()
+            .with_max_level(tracing::Level::TRACE)
+            .without_time()
+            .with_ansi(false)
+            .with_writer(move || capture.clone())
+            .finish();
+        subscriber
+            .try_init()
+            .expect("install trace and log capture");
+        tracing::trace!("owner-ingress-trace-capture-active");
+        let (events, mut event_rx) = mpsc::channel(16);
+        let shutdown = tokio_util::sync::CancellationToken::new();
+        let acceptor = start_control_socket_acceptor(
+            endpoint.clone(),
+            events,
+            shutdown.clone(),
+            DaemonShutdownAccess::Disabled,
+            WebSocketCompression::Plain,
+        )
+        .await
+        .unwrap();
+        // This is the production remote TUI connector, including its tracing suppression.
+        for _ in 0..2 {
+            let (_, (mut websocket, _)) =
+                connect_unix_socket_endpoint(endpoint.clone(), SocketPeerPolicy::ExplicitEndpoint)
+                    .await
+                    .unwrap();
+            loop {
+                if let TransportEvent::ConnectionOpened { owner_ingress, .. } =
+                    event_rx.recv().await.unwrap()
+                {
+                    assert!(owner_ingress);
+                    break;
+                }
+            }
+            websocket.close(None).await.unwrap();
+        }
+        // A public/queue connection has no proof, regardless of its RPC body later.
+        let stream = UnixStream::connect(endpoint.as_path()).await.unwrap();
+        let (mut public, _) = client_async_with_config(
+            websocket_request(UDS_WEBSOCKET_HANDSHAKE_URL).unwrap(),
+            stream,
+            None,
+        )
+        .await
+        .unwrap();
+        loop {
+            if let TransportEvent::ConnectionOpened { owner_ingress, .. } =
+                event_rx.recv().await.unwrap()
+            {
+                assert!(!owner_ingress);
+                break;
+            }
+        }
+        public.close(None).await.unwrap();
+        // A wrong proof is rejected; trace must not retain the header even on failure.
+        let mut request = websocket_request(UDS_WEBSOCKET_HANDSHAKE_URL).unwrap();
+        let wrong = "00".repeat(32);
+        let mut header = HeaderValue::from_str(&wrong).unwrap();
+        header.set_sensitive(true);
+        request
+            .headers_mut()
+            .insert(codex_app_server_transport::owner_ingress::HEADER, header);
+        let stream = UnixStream::connect(endpoint.as_path()).await.unwrap();
+        assert!(
+            client_async_with_config(request, stream, None)
+                .with_subscriber(tracing::subscriber::NoSubscriber::default())
+                .await
+                .is_err()
+        );
+        shutdown.cancel();
+        acceptor.await.unwrap();
+        let output = captured.lock().unwrap().clone();
+        assert!(String::from_utf8_lossy(&output).contains("owner-ingress-trace-capture-active"));
+        let hex: String = secret.iter().map(|byte| format!("{byte:02x}")).collect();
+        let base64 = base64::engine::general_purpose::STANDARD.encode(secret);
+        for sensitive in [
+            &secret[..],
+            hex.as_bytes(),
+            base64.as_bytes(),
+            wrong.as_bytes(),
+        ] {
+            assert!(
+                !output
+                    .windows(sensitive.len())
+                    .any(|bytes| bytes == sensitive),
+                "proof reached tracing output"
+            );
+        }
+    }
+}
